<?xml version="1.0" encoding="utf-8"?>
<!--
    Langue par défaut : l'anglais, et non le français dans lequel l'app a été
    écrite. C'est ce dossier non qualifié que le système sert à quiconque n'a
    aucune des cinq langues.
-->
<resources>
    <string name="app_name" translatable="false">Haloglyph</string>

    <!-- ============ Onglets d'application ============
         Icônes seules dans la barre du bas ; ces libellés ne servent qu'à
         l'accessibilité. -->
    <string name="nav_toys">Toys</string>
    <string name="nav_cast" translatable="false">Cast</string>
    <string name="nav_params">Settings</string>

    <!-- ============ Onglet toys ============ -->

    <!-- Titre en tête de l'onglet, nom propre non traduit — comme
         `hub_glyph_toys` juste en dessous, qui désigne autre chose (l'écran
         système), mais partage le même nom de scène. -->
    <string name="title_toys" translatable="false">Glyph toys</string>
    <string name="hub_chip_soon">Coming</string>
    <!-- Toy présent et déclaré, mais privé de l'autorisation dont il vit. Dire
         « pas dans Glyph Interface » serait faux et enverrait chercher au
         mauvais endroit — d'où ces deux pastilles, dont la seconde dit où aller. -->
    <string name="hub_chip_mic_denied">Microphone denied</string>
    <string name="hub_chip_fix_here">Open to fix</string>

    <!-- Les deux écrans Glyph du système, dans l'onglet paramètres. Noms
         propres, non traduits : ce sont ceux que porte Nothing OS lui-même.
         Côte à côte sur une seule ligne : garder ces libellés courts, une
         pilule ne coupe pas son texte. -->
    <string name="hub_glyph_matrix" translatable="false">Glyph matrix</string>
    <string name="hub_glyph_toys" translatable="false">Glyph toys</string>

    <!-- ============ Onglet cast ============
         Rien derrière pour l'instant (PRODUIT §6, « Envisagé après »). -->
    <string name="title_cast" translatable="false">Glyphcast</string>
    <string name="cast_soon">Coming soon</string>

    <!-- ============ Onglet paramètres ============
         Un seul réglage à date, et c'est voulu : est global ce qui a la même
         valeur pour tous les toys (PRODUIT §5.4). Les deux boutons Glyph du
         système, eux, ne sont pas un réglage mais une sortie — d'où leur
         section à part. -->
    <string name="title_params">Settings</string>
    <string name="settings_section_app">Application</string>
    <string name="settings_language">Language</string>
    <!-- Suivre la langue du téléphone, plutôt qu'en forcer une. -->
    <string name="language_system">System</string>
    <string name="settings_section_glyph" translatable="false">Glyph Interface</string>

    <!-- Plus aucun toy annoncé : les trois du pack sont écrits, et chacun porte
         ses chaînes dans son module. « Sono — Spectre » et « Sono — Aiguille »
         ont disparu d'ici en même temps qu'ils ont fusionné en un seul toy à
         trois modes. -->

    <!-- ============ Le hublot d'écran d'accueil ============
         Un seul widget pour tout le pack, donc ces chaînes vivent ici, dans le
         module qui l'assemble, et non dans un toy. Les libellés de format sont
         ceux du sélecteur de widgets : ils ne se traduisent pas, comme ne se
         traduisaient pas « Dice · 2×2 » et ses pareils. -->
    <string name="widget_halo_large" translatable="false">Haloglyph · 2×2</string>
    <string name="widget_halo_small" translatable="false">Haloglyph · 1×1</string>
    <string name="widget_halo_summary">The Glyph Matrix on your home screen. Tap to interact, double tap to switch toy.</string>
</resources>
