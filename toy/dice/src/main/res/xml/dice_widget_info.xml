<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/toy_dice_summary"
    android:initialLayout="@layout/haloglyph_matrix_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewImage="@drawable/dice_toy_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
<!--
  updatePeriodMillis="0" : un dé posé ne change pas tout seul. Le widget se
  rafraîchit au tap et sur demande du service (MatrixWidgetRefresh), jamais sur
  minuterie — le mécanisme du manifeste est plafonné à 30 minutes et réveille
  l'appareil pour redessiner exactement la même image.
-->
