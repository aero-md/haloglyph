<?xml version="1.0" encoding="utf-8"?>
<!--
  Le toy porte ses propres composants. AGP les fusionne dans l'app : ajouter un
  toy ne touche pas au manifeste de `app/`. Les permissions Glyph et le bloc
  <queries> viennent de `core:glyph`, dont ce module dépend.

  **Ce toy est déclaré au système** : `android:enabled` vaut `true` sur les deux
  composants. Il apparaît donc dans Glyph Interface → Glyph Toys et dans le
  sélecteur de widgets, et le hub — qui interroge le `PackageManager` et ne lit
  rien en dur — le dit de lui-même.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Retour haptique : départ du jet, arrivée du dé, changement de solide.
         Déclarée par le toy qui vibre, pas par `core:glyph`. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Aucune permission pour l'accéléromètre : les capteurs de mouvement ne sont
      pas des permissions dangereuses (seuls ceux du corps le sont), et la
      variante réveillante du capteur évite le `WAKE_LOCK` qu'un toy à secouer
      aurait autrement demandé. Voir `Shaker`.
    -->

    <application>

        <!-- Surface 1 : la matrice. Glyph Interface liste par service, pas par
             paquet — c'est ce qui permet à une app d'exposer plusieurs toys. -->
        <service
            android:name="red.suns.haloglyph.dice.toy.DiceToyService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_dice_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/dice_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_dice_summary" />
            <!-- Appui long = solide suivant : d6 → d10 → d12 → d20 -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <!-- AOD : une image à la minute, donc le dé posé. Pas de jet — il
                 n'y a personne pour le secouer, et personne pour le lire. -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!-- Surface 2 : l'émulation, sur n'importe quel Android. Elle n'est plus
             déclarée ici. Le pack ne pose plus qu'un **hublot générique**, qui
             porte tous les toys et se change au double tap : son receiver et son
             service vivent dans `app`, le seul module qui sache ce qu'il
             embarque. Ce que ce toy apporte au hublot est du Kotlin et rien
             d'autre — voir `DiceWidgetToy`. -->

        <!-- Pas d'écran de réglages : supprimé le 2026-09-16. Il ne portait que
             l'aperçu et le choix du solide, et ce choix vit ailleurs — sur la
             matrice à l'appui long, et par hublot dans les réglages du hublot
             lui-même (`WidgetConfig`, voir `DiceWidgetToy`). L'écran ne
             changeait rien de ce que ces deux chemins ne changeaient déjà ; il
             n'était qu'une vitrine. Voir PRODUIT.md, § « Menus retirés ». -->

    </application>

</manifest>
