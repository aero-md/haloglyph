<?xml version="1.0" encoding="utf-8"?>
<!--
  Le toy porte ses propres composants. AGP les fusionne dans l'app : ajouter un
  toy ne touche pas au manifeste de `app/`. Les permissions Glyph et le bloc
  <queries> viennent de `core:glyph`, dont ce module dépend.

  Contrairement à `toy:lapse`, resté en prototype désactivé, **ce toy est
  déclaré au système** : `android:enabled` vaut `true` sur les deux composants.
  Il apparaît donc dans Glyph Interface → Glyph Toys et dans le sélecteur de
  widgets, et le hub — qui interroge le `PackageManager` et ne lit rien en dur —
  le dira de lui-même.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Retour haptique : départ du jet, arrivée du dé, changement de solide.
         Déclarée par le toy qui vibre, pas par `core:glyph`. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Aucune permission pour l'accéléromètre : les capteurs de mouvement ne sont
      pas des permissions dangereuses (seuls ceux du corps le sont), et la
      variante réveillante du capteur évite le `WAKE_LOCK` qu'un toy à secouer
      aurait autrement demandé. Voir `Shaker`.
    -->

    <application>

        <!-- Surface 1 : la matrice. Glyph Interface liste par service, pas par
             paquet — c'est ce qui permet à une app d'exposer plusieurs toys. -->
        <service
            android:name="red.suns.haloglyph.dice.toy.DiceToyService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_dice_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/dice_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_dice_summary" />
            <!-- Appui long = solide suivant : d6 → d10 → d12 → d20 -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <!-- AOD : une image à la minute, donc le dé posé. Pas de jet — il
                 n'y a personne pour le secouer, et personne pour le lire. -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!-- Surface 2 : l'émulation, sur n'importe quel Android. Non exporté :
             seul le système lui parle, via un composant explicite. -->
        <receiver
            android:name="red.suns.haloglyph.dice.widget.DiceWidget"
            android:enabled="true"
            android:exported="false"
            android:label="@string/toy_dice_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dice_widget_info" />
        </receiver>

        <!-- Pas de surface 3. Ce toy n'a pas d'écran de réglages parce qu'il n'a
             rien à régler : le solide se change à l'appui long, la face se tire
             en secouant. Un écran n'y ajouterait qu'un endroit de plus où
             refaire ce que le geste fait déjà. -->

    </application>

</manifest>
