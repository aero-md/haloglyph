<?xml version="1.0" encoding="utf-8"?>
<!--
  Le toy porte ses propres composants. AGP les fusionne dans l'app : ajouter un
  toy ne touche pas au manifeste de `app/`. Les permissions Glyph et le bloc
  <queries> viennent de `core:glyph`, dont ce module dépend.

  Aucune permission d'exécution : l'accéléromètre, le magnétomètre et le vecteur
  de rotation sont des capteurs **ordinaires**, lisibles sans rien demander. Seul
  le retour haptique se déclare.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Retour haptique : mise de niveau, remise à zéro, changement de mode.
         C'est la seule façon pour le toy de parler à qui regarde le dos du
         téléphone sans le retourner. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- `required="false"` sur les deux, comme le micro de Sono : le pack
         embarque quatre toys et trois n'ont besoin d'aucun capteur de pose.
         Les exiger retirerait Lapse, Dice et Sono du Play Store sur les
         appareils concernés, pour un toy qu'ils n'auraient pas utilisé.

         La boussole n'est pas une exigence non plus : sans magnétomètre le mode
         le dit à l'écran, le niveau reste entier. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />

    <application>

        <!-- Surface 1 : la matrice. Glyph Interface liste par service, pas par
             paquet — c'est ce qui permet à une app d'exposer plusieurs toys. -->
        <service
            android:name="red.suns.haloglyph.plumb.toy.PlumbToyService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_plumb_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/plumb_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_plumb_summary" />
            <!-- Appui long = instrument suivant : niveau ↔ boussole -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <!-- Pas d'`aod_support`, délibérément. L'Always-On ne redemande une
                 image qu'à la minute : un niveau qui affiche la pose d'il y a
                 cinquante secondes n'est pas un niveau lent, c'est un niveau
                 faux. Même raisonnement que Sono, pour un coût différent. -->
        </service>

        <!-- Surface 2 : le hublot d'écran d'accueil. Il n'est pas déclaré ici —
             le pack ne pose qu'un hublot générique, qui porte tous les toys et
             vit dans `app`. Ce que ce toy lui apporte est du Kotlin et rien
             d'autre : voir `PlumbWidgetToy`. -->

        <!-- Pas d'écran de réglages : supprimé le 2026-09-16. L'instrument se
             change au geste (appui long, tap de hublot), et la portée n'avait
             qu'un réglage — retiré, elle reste fixe à `PlumbRange.DEFAULT`. Voir
             PRODUIT.md, § « Menus retirés ». -->

    </application>

</manifest>
