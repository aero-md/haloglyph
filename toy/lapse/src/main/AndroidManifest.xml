<?xml version="1.0" encoding="utf-8"?>
<!--
  Le toy porte ses propres composants. AGP les fusionne dans l'app : ajouter un
  toy ne touche pas au manifeste de `app/`. Les permissions Glyph et le bloc
  <queries> viennent de `core:glyph`, dont ce module dépend.

  Le service Glyph est **ouvert** : `android:enabled` vaut `true`, donc le toy
  apparaît dans Glyph Interface → Glyph Toys.

  Il a porté `false` le temps du prototype du 06.09.2026, où l'app n'était qu'un
  écran de réglages à regarder. L'attribut avait été préféré à un bloc commenté
  précisément pour ça : le manifeste restait complet et relu par les outils, et
  le rouvrir n'a été qu'un mot à changer.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Retour haptique : changement de format, changement de lapse, arrivée du
         compte à rebours. Déclarée par le toy qui vibre, pas par `core:glyph`. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>

        <!-- Surface 1 : la matrice. Glyph Interface liste par service, pas par
             paquet — c'est ce qui permet à une app d'exposer plusieurs toys. -->
        <service
            android:name="red.suns.haloglyph.lapse.toy.LapseToyService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_lapse_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_lapse_summary" />
            <!-- Appui long = lapse activé suivant -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <!-- AOD : EVENT_AOD chaque minute, rendu statique sans anneau -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!-- Surface 2 : l'émulation, sur n'importe quel Android. Elle n'est plus
             déclarée ici. Le pack ne pose plus qu'un **hublot générique**, qui
             porte tous les toys et se change au double tap : son receiver et son
             service vivent dans `app`, le seul module qui sache ce qu'il
             embarque. Ce que ce toy apporte au hublot est du Kotlin et rien
             d'autre — voir `LapseWidgetToy`. -->

        <!-- Surface 3 : les réglages. Lancée par le hub, jamais par le système :
             `exported` reste faux, et il n'y a pas d'intent-filter à écrire. -->
        <activity
            android:name="red.suns.haloglyph.lapse.settings.LapseSettingsActivity"
            android:exported="false"
            android:label="@string/toy_lapse_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Gérer les lapses : atteinte depuis le quick switch de la surface 3,
             jamais directement — mêmes conditions d'exposition. -->
        <activity
            android:name="red.suns.haloglyph.lapse.settings.LapseManageActivity"
            android:exported="false"
            android:label="@string/lapse_manage_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

    </application>

</manifest>
